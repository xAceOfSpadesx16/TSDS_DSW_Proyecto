# Variables de entorno del frontend (copiar a .env.local si hace falta).
# La URL de la API ya usa http://127.0.0.1:8000/api por defecto.
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Cliente de Google AdSense (formato ca-pub-XXXXXXXXXXXXXXXX).
# Vacío = los espacios publicitarios se muestran como recuadros de reserva.
# El script de AdSense no se carga en esta versión.
VITE_ADSENSE_CLIENT=
